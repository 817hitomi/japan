{
  "name": "japannote",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:admin-auth && npm run test:security-routes && npm run test:note-og-security && npm run test:affiliate-performance && npm run test:article-isr && npm run test:admin-notes-performance && npm run test:admin-quiz-performance",
    "test:admin-auth": "node --experimental-strip-types tests/adminAuth.assertions.ts",
    "test:security-routes": "node --experimental-strip-types tests/securityRoutes.assertions.ts",
    "test:note-og-security": "node --experimental-strip-types tests/noteOgSecurity.assertions.ts",
    "test:affiliate-performance": "node --experimental-strip-types tests/affiliatePerformance.assertions.ts",
    "test:article-isr": "node --experimental-strip-types tests/articleIsr.assertions.ts",
    "test:admin-notes-performance": "node --experimental-strip-types tests/adminNotesPerformance.assertions.ts",
    "test:admin-quiz-performance": "node --experimental-strip-types tests/adminQuizPerformance.assertions.ts",
    "benchmark:affiliate-remote": "node tests/affiliateRemoteBenchmark.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.50.3",
    "next": "^15.5.19",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sass": "^1.89.2"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.62.1",
    "@types/node": "^22.15.32",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.39.4",
    "typescript": "^5.8.2",
    "wrangler": "^4.106.0"
  }
}
